---
import { site } from '../config/site';
---

<section id="contact" class="slide-section relative flex w-full items-center justify-center px-6 py-14 md:px-16 md:py-0">
  <div class="w-full max-w-7xl">
    <div class="mb-10 md:mb-16">
      <div class="reveal mb-4 font-body text-sm text-[var(--color-muted)]">
        <span class="text-[var(--color-accent)]">$</span> echo "contact"
      </div>
      <h2 class="reveal mb-4 font-heading text-4xl md:text-7xl" style="--reveal-delay: 0.08s">LET'S<br/>CONNECT</h2>
    </div>

    <div class="max-w-3xl space-y-5 md:space-y-6">
      <div class="reveal info-block pl-6" style="--reveal-delay: 0.16s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">Email</div>
        <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1">
          <a
            href={`mailto:${site.email}`}
            class="arrow-link safe-link font-body text-lg sm:text-xl md:text-3xl"
          >
            <span class="arrow" aria-hidden="true">→</span> <span id="email-address">{site.email}</span>
          </a>
          <button
            type="button"
            id="copy-email"
            data-email={site.email}
            aria-describedby="copy-email-status"
            class="copy-control min-h-8 items-center border border-[var(--color-line)] px-2.5 py-1 font-body text-xs uppercase tracking-caps text-[var(--color-muted)] transition-colors hover:border-[var(--color-accent-dim)] hover:text-[var(--color-accent)] disabled:cursor-wait disabled:opacity-60"
          >
            copy
          </button>
          <span id="copy-email-status" class="sr-only" aria-live="polite"></span>
        </div>
      </div>

      <div class="reveal info-block pl-6" style="--reveal-delay: 0.24s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">GitHub</div>
        <a
          href={site.socials.github.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="GitHub profile (opens in a new tab)"
          class="arrow-link safe-link font-body text-lg sm:text-xl md:text-3xl"
        >
          <span class="arrow" aria-hidden="true">→</span> {site.socials.github.display}
        </a>
      </div>

      <div class="reveal info-block pl-6" style="--reveal-delay: 0.32s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">LinkedIn</div>
        <a
          href={site.socials.linkedin.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn profile (opens in a new tab)"
          class="arrow-link safe-link font-body text-lg sm:text-xl md:text-3xl"
        >
          <span class="arrow" aria-hidden="true">→</span> {site.socials.linkedin.display}
        </a>
      </div>
    </div>

    <div class="reveal mt-10 font-body text-xs text-[var(--color-muted)] md:mt-16" style="--reveal-delay: 0.4s">
      <span class="text-[var(--color-accent)]">$</span> status: <span class="text-[var(--color-text)]">{site.availabilityLong}</span>
    </div>

    <footer class="reveal mt-8 border-t border-[var(--color-line)] pt-4 font-body text-xs text-[var(--color-muted)]" style="--reveal-delay: 0.48s">
      © {new Date().getFullYear()} {site.name} · built with Astro
    </footer>
  </div>
</section>

<script>
  const copyButton = document.getElementById('copy-email') as HTMLButtonElement | null;
  const copyStatus = document.getElementById('copy-email-status');
  const emailAddress = document.getElementById('email-address');

  function selectEmailForManualCopy() {
    if (!emailAddress) return false;
    const selection = window.getSelection();
    if (!selection) return false;

    const range = document.createRange();
    range.selectNodeContents(emailAddress);
    selection.removeAllRanges();
    selection.addRange(range);
    return true;
  }

  if (copyButton) {
    copyButton.addEventListener('click', async () => {
      const email = copyButton.dataset.email ?? '';
      copyButton.disabled = true;
      if (copyStatus) copyStatus.textContent = '';

      try {
        if (!navigator.clipboard?.writeText) {
          throw new Error('Clipboard API unavailable');
        }
        await navigator.clipboard.writeText(email);
        copyButton.textContent = 'copied ✓';
        if (copyStatus) copyStatus.textContent = 'Email address copied to the clipboard.';
      } catch {
        const selected = selectEmailForManualCopy();
        copyButton.textContent = selected ? 'selected' : 'copy failed';
        if (copyStatus) {
          copyStatus.textContent = selected
            ? 'Email address selected. Press Control C or Command C to copy it.'
            : 'Copy failed. Use the email link or select the address manually.';
        }
      } finally {
        window.setTimeout(() => {
          copyButton.textContent = 'copy';
          copyButton.disabled = false;
        }, 2400);
      }
    });
    copyButton.classList.add('is-enhanced');
  }
</script>
