---
import { getPortfolioProjects } from '../lib/projects';

const projects = await getPortfolioProjects();
---

<section id="work" class="slide-section relative flex w-full items-center justify-center px-6 py-6 sm:py-14 md:px-16 md:py-20">
  <div class="w-full max-w-7xl">
    <div class="mb-4 md:mb-12">
      <div class="reveal mb-3 font-body text-sm text-[var(--color-muted)] md:mb-4">
        <span class="text-[var(--color-accent)]">$</span> ls -la ./projects
      </div>
      <h2 class="reveal mb-4 font-heading text-4xl md:text-7xl" style="--reveal-delay: 0.08s">SELECTED<br/>WORK</h2>
    </div>

    {projects.length > 0 ? (
      <div class="reveal project-deck grid gap-3 md:grid-cols-[minmax(15rem,0.8fr)_minmax(0,1.4fr)] md:gap-12" style="--reveal-delay: 0.16s" data-project-deck>
        <nav
          class="project-rail flex gap-2 overflow-x-auto pb-2 md:max-h-[23rem] md:flex-col md:overflow-x-hidden md:overflow-y-auto md:pb-0"
          aria-label="Selected projects"
          data-project-rail
        >
          {projects.map((project, index) => (
            <a
              href={`#project-panel-${project.num}`}
              id={`project-tab-${project.num}`}
              class={`project-tab min-w-[10rem] border-l-2 px-3 py-2 text-left md:min-w-0 md:px-4 md:py-3 ${index === 0 ? 'is-active' : ''}`}
              data-project-index={index}
            >
              <span class="project-tab-number font-heading text-2xl text-[var(--color-accent)]">
                {project.num}
              </span>
              <span class="mt-1 block font-heading text-sm leading-tight text-[var(--color-text)] md:text-lg">
                {project.title}
              </span>
              <span class="mt-1 block font-body text-[0.65rem] uppercase tracking-caps text-[var(--color-muted)] md:mt-2 md:text-[0.7rem]">
                {project.highlight}
              </span>
            </a>
          ))}
        </nav>

        <div class="project-stage border-l-2 border-[var(--color-accent)] pl-5 sm:pl-6 md:min-h-[23rem]">
          {projects.map((project, index) => (
            <article
              id={`project-panel-${project.num}`}
              class={`project-panel ${index === 0 ? 'is-active' : ''}`}
              data-project-panel
            >
              <div class="mb-4 flex items-start justify-between gap-4 md:mb-5">
                <div>
                  <div class="mb-2 font-body text-xs text-[var(--color-muted)] md:mb-3">
                    <span class="text-[var(--color-accent)]">$</span> open ./projects/{project.num}
                  </div>
                  <h3 class="font-heading text-3xl md:text-6xl">
                    {project.title}
                  </h3>
                </div>
                <div class="whitespace-nowrap pt-1 font-body text-xs">
                  <span class="text-[var(--color-accent)]">{project.num}</span>
                  <span class="text-[var(--color-muted)]"> / {String(projects.length).padStart(2, '0')}</span>
                </div>
              </div>

              <p class="max-w-3xl text-sm font-light leading-5 text-[var(--color-muted)] md:text-base md:leading-7">
                {project.description}
              </p>

              <ul class="mt-4 flex flex-wrap gap-2 font-body text-xs md:mt-6 md:gap-3" role="list" aria-label={`${project.title} technologies`}>
                {project.tech.map((technology) => (
                  <li class="tech-chip px-3 py-1">
                    {technology}
                  </li>
                ))}
              </ul>

              <div class="mt-4 grid gap-3 sm:grid-cols-[minmax(0,1fr)_auto] sm:items-end md:mt-6">
                <div>
                  {project.example ? (
                    <>
                      <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">In practice</div>
                      <p class="max-w-prose text-sm leading-5">{project.example.detail}</p>
                      <a href={project.example.source} class="arrow-link mt-2 inline-block font-body text-sm"
                        aria-label={`Read the ${project.title} test on GitHub`}>Read the test <span aria-hidden="true">↗</span></a>
                    </>
                  ) : (
                    <>
                      <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">Highlight</div>
                      <div class="font-body text-sm text-[var(--color-accent)]">
                        {project.highlight}
                      </div>
                    </>
                  )}
                </div>

                <div class="flex flex-col items-start gap-2 font-body sm:items-end">
                  {project.repositoryNote && (
                    <span class="max-w-xs text-xs text-[var(--color-muted)] sm:text-right">
                      {project.repositoryNote}
                    </span>
                  )}

                  <div class="flex flex-wrap gap-5 text-sm">
                    {project.githubUrl ? (
                      <a
                        href={project.githubUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={project.repositoryLinkAriaLabel}
                        class="arrow-link"
                      >
                        <span class="arrow" aria-hidden="true">→</span> {project.repositoryLinkLabel}
                      </a>
                    ) : null}

                    {project.homepage && (
                      <a
                        href={project.homepage}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${project.title} live site (opens in a new tab)`}
                        class="arrow-link"
                      >
                        <span class="arrow" aria-hidden="true">→</span> live
                      </a>
                    )}
                  </div>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    ) : (
      <p class="reveal border-l-2 border-[var(--color-accent)] pl-5 font-body text-sm text-[var(--color-muted)]" role="status">
        Project details are temporarily unavailable. Public repositories remain available from the GitHub profile.
      </p>
    )}
  </div>
</section>

<script>
  const decks = document.querySelectorAll<HTMLElement>('[data-project-deck]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  decks.forEach((deck) => {
    const rail = deck.querySelector<HTMLElement>('[data-project-rail]');
    const tabs = Array.from(deck.querySelectorAll<HTMLAnchorElement>('[data-project-index]'));
    const panels = Array.from(deck.querySelectorAll<HTMLElement>('[data-project-panel]'));
    if (!rail || tabs.length === 0 || panels.length === 0) return;

    rail.setAttribute('role', 'tablist');
    const desktopLayout = window.matchMedia('(min-width: 768px)');
    const syncOrientation = () => {
      rail.setAttribute('aria-orientation', desktopLayout.matches ? 'vertical' : 'horizontal');
    };
    syncOrientation();
    desktopLayout.addEventListener('change', syncOrientation);

    tabs.forEach((tab, index) => {
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panels[index]?.id ?? '');
    });

    panels.forEach((panel, index) => {
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tabs[index]?.id ?? '');
      panel.tabIndex = 0;
    });

    function activateProject(index: number, focusTab = false, scrollTab = true) {
      if (index < 0 || index >= tabs.length) return;

      tabs.forEach((tab, tabIndex) => {
        const isActive = tabIndex === index;
        tab.classList.toggle('is-active', isActive);
        tab.setAttribute('aria-selected', String(isActive));
        tab.tabIndex = isActive ? 0 : -1;
      });

      panels.forEach((panel, panelIndex) => {
        const isActive = panelIndex === index;
        panel.classList.toggle('is-active', isActive);
        panel.hidden = !isActive;
      });

      if (scrollTab) tabs[index]?.scrollIntoView({
        behavior: reducedMotion.matches ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'nearest'
      });

      if (focusTab) {
        tabs[index]?.focus();
      }
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        activateProject(tabs.indexOf(tab));
      });

      tab.addEventListener('keydown', (event) => {
        const currentIndex = tabs.indexOf(tab);
        let nextIndex = currentIndex;

        switch (event.key) {
          case 'ArrowRight':
          case 'ArrowDown':
            nextIndex = (currentIndex + 1) % tabs.length;
            break;
          case 'ArrowLeft':
          case 'ArrowUp':
            nextIndex = (currentIndex - 1 + tabs.length) % tabs.length;
            break;
          case 'Home':
            nextIndex = 0;
            break;
          case 'End':
            nextIndex = tabs.length - 1;
            break;
          default:
            return;
        }

        event.preventDefault();
        event.stopPropagation();
        activateProject(nextIndex, true);
      });
    });

    deck.classList.add('is-enhanced');
    const linkedPanelIndex = panels.findIndex((panel) => `#${panel.id}` === window.location.hash);
    // Initial enhancement must not move the browser's sequential focus origin.
    activateProject(linkedPanelIndex >= 0 ? linkedPanelIndex : 0, false, false);
  });
</script>
