---
import { site } from '../config/site';
---

<section id="intro" class="slide-section relative flex w-full items-center justify-center px-6 py-16 md:px-16 md:py-0">
  <div class="w-full max-w-7xl">
    <div class="reveal mb-8 font-body text-sm text-[var(--color-muted)]">
      <span class="text-[var(--color-accent)]">$</span> <span id="typed-cmd" data-cmd="whoami">whoami</span>
    </div>

    <h1 class="reveal cursor-blink mb-6 font-heading text-5xl sm:text-6xl md:text-8xl lg:text-9xl" style="--reveal-delay: 0.08s">
      {site.firstName.toUpperCase()}<br/>{site.lastName.toUpperCase()}
    </h1>

    <p class="reveal mb-5 font-body text-base font-light uppercase tracking-caps text-[var(--color-accent)] md:text-xl" style="--reveal-delay: 0.16s">
      {site.role}
    </p>

    <div class="reveal mb-12 flex flex-wrap items-center gap-x-6 gap-y-2 font-body text-xs text-[var(--color-muted)]" style="--reveal-delay: 0.22s">
      <span class="inline-flex items-center gap-2.5">
        <span class="status-dot" aria-hidden="true"></span>
        {site.availability}
      </span>
      <span aria-hidden="true" class="hidden text-[var(--color-line)] sm:inline">|</span>
      <span>{site.location.city}, {site.location.countryCode} · {site.location.timeZone}</span>
    </div>

    <div class="grid max-w-4xl grid-cols-1 gap-6 md:grid-cols-3 md:gap-8">
      <div class="reveal info-block pl-4" style="--reveal-delay: 0.3s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">Focus</div>
        <div class="text-sm font-light leading-6">Flutter and backend APIs<br/>Offline-first systems</div>
      </div>

      <div class="reveal info-block pl-4" style="--reveal-delay: 0.38s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">Stack</div>
        <div class="text-sm font-light leading-6">Dart / C# / Go / Python<br/>Flutter / ASP.NET Core / PostgreSQL</div>
      </div>

      <div class="reveal info-block pl-4" style="--reveal-delay: 0.46s">
        <div class="mb-2 font-body text-xs uppercase tracking-caps text-[var(--color-muted)]">Links</div>
        <div class="flex flex-col gap-2">
          <a
            href={site.socials.github.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub profile (opens in a new tab)"
            class="arrow-link font-body text-sm"
          >
            <span class="arrow" aria-hidden="true">→</span> github
          </a>
          <a
            href={site.socials.linkedin.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="LinkedIn profile (opens in a new tab)"
            class="arrow-link font-body text-sm"
          >
            <span class="arrow" aria-hidden="true">→</span> linkedin
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="pointer-events-none absolute bottom-8 left-1/2 -translate-x-1/2 font-body text-xs text-[var(--color-muted)]" aria-hidden="true">
    <span class="scroll-hint inline-block">scroll ↓</span>
  </div>
</section>

<script>
  // Type out the hero command unless the visitor prefers reduced motion.
  const typed = document.getElementById('typed-cmd');
  const text = typed?.dataset.cmd ?? '';
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (typed && text && !reduced) {
    typed.textContent = '';
    typed.classList.add('type-caret');

    let index = 0;
    const tick = () => {
      typed.textContent = text.slice(0, index + 1);
      index += 1;
      if (index < text.length) {
        window.setTimeout(tick, 70 + Math.random() * 60);
      } else {
        window.setTimeout(() => typed.classList.remove('type-caret'), 1600);
      }
    };

    window.setTimeout(tick, 400);
  }
</script>
