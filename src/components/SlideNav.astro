---
import { site } from '../config/site';

const sectionDefinitions = site.sections;
const totalLabel = String(sectionDefinitions.length).padStart(2, '0');
---

<div id="slide-container" class="relative app-viewport w-full overflow-x-hidden">
  <slot />
</div>

<!-- Section indicator -->
<div class="nav-js-only nav-indicator pointer-events-none fixed bottom-8 right-8 z-50 font-body text-sm" aria-hidden="true">
  <span id="current-section" class="text-2xl font-bold text-[var(--color-accent)]">01</span>
  <span class="text-[var(--color-muted)]"> / {totalLabel}</span>
</div>

<!-- Navigation dots remain useful as ordinary hash links without JavaScript. -->
<nav class="fixed left-6 top-1/2 z-50 hidden -translate-y-1/2 flex-col gap-1 lg:flex" aria-label="Section shortcuts">
  {sectionDefinitions.map((section, index) => (
    <a
      href={`#${section.id}`}
      class="nav-dot flex h-8 w-8 items-center justify-center rounded-full"
      data-section={index}
      aria-label={`Go to ${section.label}`}
    >
      <span class="nav-dot-marker" aria-hidden="true"></span>
    </a>
  ))}
</nav>

<!-- Keyboard hint -->
<div class="nav-js-only nav-hint fixed bottom-8 left-5 z-50 gap-3 font-body text-xs text-[var(--color-muted)]" aria-hidden="true">
  <span>arrow keys</span>
  <span>ESC</span>
</div>

<script>
  // The head bootstrap sets this before paint; this is a resilient fallback if that file is stale or missing.
  document.documentElement.classList.add('js');

  type HistoryMode = 'push' | 'replace' | 'none';

  const sectionElements = Array.from(document.querySelectorAll<HTMLElement>('.slide-section'));
  const dots = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-dot[data-section]'));
  const jumps = Array.from(document.querySelectorAll<HTMLAnchorElement>('.nav-jump[data-section]'));
  const scrollRoot = document.querySelector<HTMLElement>('[data-scroll-root]');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
  const interactiveSelector = [
    'a[href]',
    'button',
    'input',
    'textarea',
    'select',
    'summary',
    '[contenteditable]:not([contenteditable="false"])',
    '[role="button"]',
    '[role="tab"]',
    '[role="link"]',
    '[role="menuitem"]',
    '[role="option"]',
    '[role="slider"]',
    '[role="spinbutton"]',
    '[role="switch"]',
    '[role="textbox"]'
  ].join(',');

  let currentSection = 0;
  let snapResumeTimer: number | undefined;
  let scrollFallbackTimer: number | undefined;
  let scrollRequestId = 0;

  function setActiveSection(index: number) {
    if (index < 0 || index >= sectionElements.length) return;

    currentSection = index;

    const indicator = document.getElementById('current-section');
    if (indicator) {
      indicator.textContent = String(index + 1).padStart(2, '0');
    }

    dots.forEach((dot, dotIndex) => {
      const isActive = dotIndex === index;
      dot.classList.toggle('is-active', isActive);
      if (isActive) {
        dot.setAttribute('aria-current', 'location');
      } else {
        dot.removeAttribute('aria-current');
      }
    });

    jumps.forEach((jump) => {
      const targetIndex = Number.parseInt(jump.dataset.section ?? '-1', 10);
      const isActive = targetIndex === index;
      // Keep the brand visually neutral while still exposing its current state.
      jump.classList.toggle('is-active', isActive && targetIndex !== 0);
      if (isActive) {
        jump.setAttribute('aria-current', 'location');
      } else {
        jump.removeAttribute('aria-current');
      }
    });
  }

  function sectionURL(index: number) {
    const base = `${window.location.pathname}${window.location.search}`;
    const id = sectionElements[index]?.id;
    return index === 0 || !id ? base : `${base}#${encodeURIComponent(id)}`;
  }

  function writeHistory(index: number, mode: Exclude<HistoryMode, 'none'>) {
    const nextURL = sectionURL(index);
    const currentURL = `${window.location.pathname}${window.location.search}${window.location.hash}`;
    if (nextURL === currentURL) return;

    if (mode === 'push') {
      window.history.pushState(null, '', nextURL);
    } else {
      window.history.replaceState(null, '', nextURL);
    }
  }

  function suspendSnap() {
    if (!scrollRoot || reducedMotion.matches) return;

    scrollRoot.classList.add('snap-suspend');
    if (snapResumeTimer) window.clearTimeout(snapResumeTimer);

    const resume = () => {
      if (snapResumeTimer) window.clearTimeout(snapResumeTimer);
      snapResumeTimer = undefined;
      scrollRoot.classList.remove('snap-suspend');
    };

    if ('onscrollend' in scrollRoot) {
      scrollRoot.addEventListener('scrollend', resume, { once: true });
    }
    snapResumeTimer = window.setTimeout(resume, 1200);
  }

  function scrollToSection(index: number, behavior: ScrollBehavior) {
    const target = sectionElements[index];
    if (!target) return;

    const requestId = ++scrollRequestId;
    if (scrollFallbackTimer) {
      window.clearTimeout(scrollFallbackTimer);
      scrollFallbackTimer = undefined;
    }

    if (!scrollRoot) {
      target.scrollIntoView({ behavior, block: 'start' });
      return;
    }

    suspendSnap();
    // Flush the snap-state change before starting a smooth scroll.
    void scrollRoot.offsetHeight;
    const startTop = scrollRoot.scrollTop;
    scrollRoot.scrollTo({ top: target.offsetTop, behavior });

    if (behavior === 'smooth') {
      scrollFallbackTimer = window.setTimeout(() => {
        scrollFallbackTimer = undefined;
        if (requestId !== scrollRequestId) return;

        const stalled = Math.abs(scrollRoot.scrollTop - startTop) < 2;
        const notThere = Math.abs(scrollRoot.scrollTop - target.offsetTop) > 2;
        if (stalled && notThere) {
          scrollRoot.scrollTo({ top: target.offsetTop, behavior: 'auto' });
        }
      }, 500);
    }
  }

  function updateSection(index: number, historyMode: HistoryMode = 'push') {
    if (index < 0 || index >= sectionElements.length) return;

    setActiveSection(index);
    if (historyMode !== 'none') writeHistory(index, historyMode);
    scrollToSection(index, reducedMotion.matches ? 'auto' : 'smooth');
  }

  function targetIsInteractive(target: EventTarget | null) {
    return target instanceof Element && Boolean(target.closest(interactiveSelector));
  }

  document.addEventListener('keydown', (event) => {
    if (
      event.defaultPrevented ||
      event.metaKey ||
      event.ctrlKey ||
      event.altKey ||
      event.shiftKey ||
      targetIsInteractive(event.target)
    ) {
      return;
    }

    let nextIndex: number | undefined;
    switch (event.key) {
      case 'ArrowRight':
      case 'ArrowDown':
        nextIndex = currentSection + 1;
        break;
      case 'ArrowLeft':
      case 'ArrowUp':
        nextIndex = currentSection - 1;
        break;
      case 'Escape':
        nextIndex = 0;
        break;
      default:
        return;
    }

    if (nextIndex < 0 || nextIndex >= sectionElements.length || nextIndex === currentSection) return;
    event.preventDefault();
    updateSection(nextIndex);
  });

  [...dots, ...jumps].forEach((control) => {
    control.addEventListener('click', (event) => {
      const index = Number.parseInt(control.dataset.section ?? '-1', 10);
      if (index < 0 || index >= sectionElements.length || !scrollRoot) return;
      event.preventDefault();
      updateSection(index);
    });
  });

  // Keep controls and the URL synchronized with manual scrolling.
  if ('IntersectionObserver' in window && scrollRoot && sectionElements.length > 0) {
    const sectionObserver = new IntersectionObserver((entries) => {
      const visibleEntry = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];

      if (!visibleEntry) return;
      const visibleIndex = sectionElements.indexOf(visibleEntry.target as HTMLElement);
      if (visibleIndex < 0) return;
      setActiveSection(visibleIndex);
      writeHistory(visibleIndex, 'replace');
    }, {
      root: scrollRoot,
      threshold: [0.35, 0.6]
    });

    sectionElements.forEach((section) => sectionObserver.observe(section));
  }

  // Enhance reveal effects only after the observer is ready. The baseline is visible.
  const revealables = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  if (revealables.length > 0 && !reducedMotion.matches && 'IntersectionObserver' in window) {
    try {
      const revealObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          revealObserver.unobserve(entry.target);
        });
      }, { root: scrollRoot, threshold: 0.15 });

      document.documentElement.classList.add('reveal-enabled');
      revealables.forEach((element) => revealObserver.observe(element));
    } catch {
      document.documentElement.classList.remove('reveal-enabled');
      revealables.forEach((element) => element.classList.add('is-visible'));
    }
  } else {
    revealables.forEach((element) => element.classList.add('is-visible'));
  }

  function sectionIndexFromHash() {
    if (!window.location.hash) return 0;

    let id = window.location.hash.slice(1);
    try {
      id = decodeURIComponent(id);
    } catch {
      return 0;
    }

    const directIndex = sectionElements.findIndex((section) => section.id === id);
    if (directIndex >= 0) return directIndex;

    const nestedTarget = document.getElementById(id);
    const parentSection = nestedTarget?.closest<HTMLElement>('.slide-section');
    return parentSection ? sectionElements.indexOf(parentSection) : 0;
  }

  function syncFromLocation() {
    const index = sectionIndexFromHash();
    if (index < 0) return;
    setActiveSection(index);
    window.requestAnimationFrame(() => scrollToSection(index, 'auto'));
  }

  window.addEventListener('popstate', syncFromLocation);
  window.addEventListener('hashchange', syncFromLocation);
  document.documentElement.classList.add('nav-enhanced');
  syncFromLocation();
</script>
