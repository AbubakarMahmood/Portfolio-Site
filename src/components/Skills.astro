---
import { skillGroups } from '../data/skills';
---

<section id="stack" class="slide-section relative flex w-full items-center justify-center px-6 py-14 md:px-16 md:pb-10 md:pt-20">
  <div class="w-full max-w-7xl">
    <div class="mb-8 md:mb-10">
      <div class="reveal mb-4 font-body text-sm text-[var(--color-muted)]">
        <span class="text-[var(--color-accent)]">$</span> cat ./stack.txt
      </div>
      <h2 class="reveal mb-2 font-heading text-4xl md:text-6xl" style="--reveal-delay: 0.08s">TECHNOLOGY STACK</h2>
    </div>

    <div class="grid grid-cols-1 gap-x-6 gap-y-6 sm:grid-cols-2 md:gap-x-16 md:gap-y-8">
      {skillGroups.map((group, index) => (
        <section class="reveal info-block pl-3 sm:pl-6" style={`--reveal-delay: ${0.16 + index * 0.08}s`}>
          <h3 class="mb-3 font-body text-xs uppercase tracking-caps text-[var(--color-accent)]">
            ./{group.category}
          </h3>

          <ul class="space-y-1.5" role="list">
            {group.items.map((skill) => (
              <li class="skill-item flex items-center gap-2 font-body text-xs font-light sm:text-sm">
                <span class="text-[var(--color-muted)]" aria-hidden="true">-</span>
                <span>{skill}</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>

    <div class="reveal mt-6 border-t border-[var(--color-line)] pt-4 font-body text-xs text-[var(--color-muted)] md:mt-8" style="--reveal-delay: 0.5s">
      <span class="text-[var(--color-accent)]">info:</span> stack compiled successfully
    </div>
  </div>
</section>
