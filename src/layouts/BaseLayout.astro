---
import '@fontsource-variable/space-grotesk';
import '@fontsource-variable/jetbrains-mono';
import { site } from '../config/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}

const {
  title = site.title,
  description = site.description,
  noindex = false
} = Astro.props;

const siteURL = Astro.site ?? new URL(site.url);
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const ogImage = new URL('/og.png', siteURL);
const personId = new URL('/#person', siteURL).toString();

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': personId,
      name: site.name,
      url: siteURL.toString(),
      jobTitle: site.role,
      email: `mailto:${site.email}`,
      address: {
        '@type': 'PostalAddress',
        addressLocality: site.location.city,
        addressCountry: site.location.countryCode
      },
      sameAs: [site.socials.github.url, site.socials.linkedin.url]
    },
    {
      '@type': 'WebSite',
      '@id': new URL('/#website', siteURL).toString(),
      url: siteURL.toString(),
      name: `${site.name} Portfolio`,
      description: site.description,
      inLanguage: 'en',
      publisher: { '@id': personId }
    }
  ]
};
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#060809" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalURL} />

    <!-- Synchronous, same-origin bootstrap: progressive enhancement without an inline executable script. -->
    <script is:inline src="/js/init.js"></script>

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} - ${site.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${site.name} - ${site.role}`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <title>{title}</title>

    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  </head>
  <body class="text-[var(--color-text)]">
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <slot />
  </body>
</html>
